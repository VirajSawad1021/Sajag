# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Exact Gemma 4 model id — list them with: cd backend && python -m app.list_models
GEMMA_MODEL=
# 1 = no model, offline keyword analyzer only
SAJAG_MOCK=0
# Speech-to-text for voice notes (Gemma 4 on the API has no audio input)
SAJAG_ASR_MODEL=gemini-2.5-flash
# MINIMAL = fast; empty = model default thinking (much slower)
GEMMA_THINKING_LEVEL=MINIMAL
